            },
            {
              "name": "chatInput",
              "value": "={{ $json.chatInput || $json.input || '' }}"
            },
            {
              "name": "userId",
              "value": "={{ $json.userId || $json.sessionId || 'user_' + Date.now() }}"
            }
          ]
        },
        "options": {}
