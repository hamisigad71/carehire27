    {
      "parameters": {
        "chatId": "7443672526",
        "text": "=🔥 *NEW HOT LEAD ALERT* 🔥\n\n*CLIENT INFORMATION*\n👤 *Name:* {{ $('Process Response1').item.json.extractedName || 'Not Provided' }}\n📞 *Phone:* {{ $('Process Response1').item.json.extractedPhone || 'Not Provided' }}\n\n*PROPERTY REQUIREMENTS*\n🏠 *Type:* {{ $('Process Response1').item.json.extractedPropertyType || 'Not Provided' }}\n📍 *Location:* {{ $('Process Response1').item.json.extractedLocation || 'Not Provided' }}\n💰 *Budget:* {{ $('Process Response1').item.json.extractedBudget || 'Not Provided' }}\n\n*TIMESTAMP*\n📅 *Date:* {{ new Date().toLocaleDateString('en-GB', { timeZone: 'Africa/Nairobi' }) }}\n⏰ *Time:* {{ new Date().toLocaleTimeString('en-GB', { timeZone: 'Africa/Nairobi', hour12: false }) }}\n🌍 *Timezone:* EAT (East Africa Time)\n\n*SYSTEM INFO*\n🆔 Session: {{ $('Set Session Variables').item.json.sessionId || 'Unknown' }}\n📊 Source: AI Chatbot\n\n✅ Lead automatically saved to Google Sheets\n🚨 *ACTION REQUIRED: Follow up within 24 hours as promised!*",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
