      "parameters": {
        "keepOnlySet": false,
        "values": {
          "string": [
            {
              "name": "finalResponse",
              "value": "={{ $json.output ? $json.output.replace(/\\[HOT_LEAD\\][\\s\\S]*$/g, '').trim() : '' }}"
            },
            {
              "name": "leadSection",
              "value": "={{ $json.output && $json.output.includes('[HOT_LEAD]') ? ($json.output.match(/\\[HOT_LEAD\\][\\s\\S]*/)?.[0] || '') : '' }}"
            },
            {
              "name": "extractedName",
              "value": "={{ $json.leadSection ? ($json.leadSection.match(/Name: ([^\\n]+)/)?.[1]?.trim() || 'Not Provided') : '' }}"
            },
            {
              "name": "extractedPhone",
              "value": "={{ $json.leadSection ? ($json.leadSection.match(/Phone: ([^\\n]+)/)?.[1]?.trim() || 'Not Provided') : '' }}"
            },
            {
              "name": "extractedVehicleType",
              "value": "={{ $json.leadSection ? ($json.leadSection.match(/Property Type: ([^\\n]+)/)?.[1]?.trim() || 'Not Provided') : '' }}"
            },
            {
              "name": "extractedLocation",
              "value": "={{ $json.leadSection ? ($json.leadSection.match(/Location: ([^\\n]+)/)?.[1]?.trim() || 'Not Provided') : '' }}"
            },
            {
              "name": "extractedBudget",
              "value": "={{ $json.leadSection ? ($json.leadSection.match(/Budget: ([^\\n]+)/)?.[1]?.trim() || 'Not Provided') : '' }}"
            }
          ],
          "boolean": [
            {
              "name": "isHotLead",
              "value": "={{ $json.output ? $json.output.includes('[HOT_LEAD]') : false }}"
            }
          ]
        },
        "options": {}
      },
      "id": "1796a756-6a07-42e2-a0bc-3eaaa266d399",
